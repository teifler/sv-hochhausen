---
/* Grundlayout aller Seiten */
import '@fontsource-variable/inter/wght.css'
import '@fontsource/barlow-condensed/latin-500.css'
import '@fontsource/barlow-condensed/latin-600.css'
import '@fontsource/barlow-condensed/latin-700.css'
import '../styles/global.css'

import Header from '../components/Header.astro'
import MobileNav from '../components/MobileNav.astro'
import SearchOverlay from '../components/SearchOverlay.astro'
import Footer from '../components/Footer.astro'
import BackToTop from '../components/BackToTop.astro'
import { club, contact, socials } from '../data/site.js'

interface Props {
  title?: string
  description?: string
  image?: string
  noindex?: boolean
}
const { title, description = `${club.legalName}: ${club.tagline}`, image = '/og.jpg', noindex = false } = Astro.props
const fullTitle = title ? `${title} | SV Hochhausen 1946` : 'SV Hochhausen 1946 e.V. – Mehr als Fußball'
const site = Astro.site ?? new URL('https://sv-hochhausen.vercel.app')
const canonical = new URL(Astro.url.pathname, site).href
const ogImage = new URL(image, site).href

const ld = {
  '@context': 'https://schema.org',
  '@type': 'SportsClub',
  name: club.legalName,
  alternateName: 'SV Hochhausen',
  url: site.href,
  logo: new URL('/wappen.png', site).href,
  foundingDate: String(club.founded),
  email: contact.main.email,
  telephone: '+49 9341 12534',
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.main.street,
    postalCode: contact.main.zip,
    addressLocality: 'Tauberbischofsheim-Hochhausen',
    addressCountry: 'DE',
  },
  sameAs: socials.filter((s) => s.url).map((s) => s.url),
}
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="SV Hochhausen 1946" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#c8102e" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
    <!-- Seitenwechsel-Animation: abgebrochene Übergänge (z. B. schnelles Weiterklicken) still behandeln -->
    <script is:inline>
      ;(function () {
        var n = function () {}
        function h(e) {
          var t = e.viewTransition
          if (t) {
            t.ready.catch(n)
            t.finished.catch(n)
            t.updateCallbackDone.catch(n)
          }
        }
        addEventListener('pagereveal', h)
        addEventListener('pageswap', h)
      })()
    </script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)}></script>
  </head>
  <body>
    <a class="svh-skip-link" href="#svh-main">
      Zum Inhalt springen
    </a>
    <Header />
    <MobileNav />
    <SearchOverlay />
    <main id="svh-main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <script>
      import '../scripts/site.js'
    </script>
  </body>
</html>
