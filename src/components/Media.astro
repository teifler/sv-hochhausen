---
/* Bildrahmen mit festem Seitenverhältnis */
import Pic from './Pic.astro'

interface Props {
  theme: string
  seed?: number
  alt?: string
  ratio?: '16x9' | '3x2' | '4x3' | '1x1' | '3x4' | '21x9' | 'fill'
  zoom?: boolean
  overlay?: boolean
  width?: number
  sizes?: string
  eager?: boolean
  class?: string
  photo?: boolean
  minScale?: number
}
const {
  theme,
  seed = 1,
  alt = '',
  ratio = '16x9',
  zoom = false,
  overlay = false,
  width = 900,
  sizes = '(max-width: 560px) 100vw, (max-width: 1000px) 50vw, 400px',
  eager = false,
  class: cls,
  photo = true,
  minScale = 0.6,
} = Astro.props
const [rw, rh] = ratio === 'fill' ? [4, 3] : ratio.split('x').map(Number)
---

<div
  class:list={['svh-media', ratio === 'fill' ? 'svh-media--fill' : `svh-media--r-${ratio}`, zoom && 'svh-zoom', cls]}
>
  <Pic
    theme={theme}
    seed={seed}
    alt={alt}
    width={width}
    sizes={sizes}
    eager={eager}
    photo={photo}
    minScale={minScale}
    w={1200}
    h={Math.round((1200 * rh) / rw)}
  />
  {overlay && <span class="svh-media__overlay"></span>}
  <slot />
</div>
