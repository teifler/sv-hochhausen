---
/* Vereinswappen
   Original: src/assets/wappen.png (Quelle: fussball.de-Vereinsseite /
   alte Vereinswebsite). Fehlt die Datei, zeigt die Seite einen
   gezeichneten Platzhalter in Vereinsfarben. */
import { getImage } from 'astro:assets'

interface Props {
  class?: string
  size?: number
  title?: string
}
const { class: cls, size = 64, title = 'Wappen SV Hochhausen 1946' } = Astro.props

const files = import.meta.glob('/src/assets/wappen.{png,webp}', { eager: true, import: 'default' })
const wappen: any = Object.values(files)[0]
let img: { src: string; srcset: string; w: number } | null = null
if (wappen) {
  const w = Math.round((wappen.width / wappen.height) * size)
  const densities = [1, 2, 3].filter((d) => w * d <= wappen.width)
  const opt = await getImage({ src: wappen, width: w, densities: densities.length ? densities : [1], format: 'webp', quality: 90 })
  img = { src: opt.src, srcset: opt.srcSet?.attribute || '', w }
}
const uid = `svhc${Math.random().toString(36).slice(2, 8)}`
---
{
  img ? (
    <img class:list={['svh-logo', cls]} src={img.src} srcset={img.srcset || undefined} width={img.w} height={size} alt={title} decoding="async" />
  ) : (
    <svg class:list={['svh-logo', cls]} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width={size} height={size} role="img" aria-label={title}>
      <defs>
        <clipPath id={`${uid}c`}>
          <path d="M32 2.5 58 11.2V31c0 15.5-11.2 25.8-26 30.5C17.2 56.8 6 46.5 6 31V11.2Z" />
        </clipPath>
      </defs>
      <g clip-path={`url(#${uid}c)`}>
        <rect x="0" y="0" width="23.5" height="64" fill="#1d4fb8" />
        <rect x="23.5" y="0" width="17" height="64" fill="#14161b" />
        <rect x="40.5" y="0" width="23.5" height="64" fill="#c8102e" />
        <rect x="0" y="23" width="64" height="16" fill="#fff" />
      </g>
      <path d="M32 2.5 58 11.2V31c0 15.5-11.2 25.8-26 30.5C17.2 56.8 6 46.5 6 31V11.2Z" fill="none" stroke="#fff" stroke-width="2.5" />
      <text x="32" y="35.6" text-anchor="middle" font-family="'Barlow Condensed','Arial Narrow',Arial,sans-serif" font-weight="700" font-size="14.5" fill="#14161b">SVH</text>
      <text x="32" y="50.5" text-anchor="middle" font-family="'Barlow Condensed','Arial Narrow',Arial,sans-serif" font-weight="700" font-size="9.5" letter-spacing="1.6" fill="#fff">1946</text>
    </svg>
  )
}
