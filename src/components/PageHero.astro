---
/* Kopfbereich der Unterseiten mit Breadcrumb */
import Pic from './Pic.astro'

interface Crumb {
  label: string
  to?: string
}
interface Props {
  title: string
  eyebrow?: string
  lead?: string
  theme?: string
  seed?: number
  crumbs?: Crumb[]
}
const { title, eyebrow, lead, theme = 'hero', seed = 1, crumbs = [] } = Astro.props
const trail: Crumb[] = [{ label: 'Start', to: '/' }, ...crumbs, { label: title }]
---
<section class="svh-pagehero">
  <div class="svh-pagehero__bg" data-parallax><Pic theme={theme} seed={seed} clean width={1600} widths={[800, 1200, 1600]} sizes="100vw" eager w={1600} h={600} /></div>
  <div class="svh-pagehero__scrim"></div>
  <div class="svh-container svh-pagehero__inner">
    <nav class="svh-breadcrumb" aria-label="Brotkrumen-Navigation">
      <ol>
        {trail.map((c, i) => (i < trail.length - 1 && c.to ? <li><a href={c.to}>{c.label}</a></li> : <li aria-current="page">{c.label}</li>))}
      </ol>
    </nav>
    {eyebrow && <p class="svh-pagehero__eyebrow">{eyebrow}</p>}
    <h1 class="svh-pagehero__title">{title}</h1>
    {lead && <p class="svh-pagehero__lead">{lead}</p>}
    <slot />
  </div>
</section>
