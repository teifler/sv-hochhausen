---
/* Instagram-Beiträge (lokal gespeicherte Bilder, kein Tracking).
   Ohne Feed: Bild-Teaser mit Link zum Profil. */
import Icon from './Icon.astro'
import Pic from './Pic.astro'
import { instagramPosts } from '../lib/instagram.js'
import { instagram } from '../data/site.js'

interface Props {
  limit?: number
}
const { limit = 6 } = Astro.props
const posts = await instagramPosts(limit)
const short = (s = '') => (s.length > 110 ? `${s.slice(0, 107).trim()}…` : s)
const tiles = [
  ['football', 61],
  ['archery', 62],
  ['hiking', 63],
  ['darts', 64],
  ['gym', 65],
  ['fest', 66],
  ['nordic', 67],
  ['community', 68],
].slice(0, Math.max(6, Math.min(8, limit)))
---

{posts.length ? (
  <div class="svh-insta__grid">
    {posts.map((p) => (
      <a
        class="svh-insta__item"
        href={p.permalink}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Instagram-Beitrag öffnen${p.caption ? `: ${short(p.caption)}` : ''}`}
      >
        <img
          class="svh-img"
          src={p.src}
          srcset={p.srcset || undefined}
          sizes="(max-width: 480px) 50vw, (max-width: 1000px) 33vw, 200px"
          width={p.width}
          height={p.height}
          alt=""
          loading="lazy"
          decoding="async"
        />
        {p.type === 'VIDEO' && (
          <span class="svh-insta__type">
            <Icon name="play" />
          </span>
        )}
        {p.type === 'CAROUSEL_ALBUM' && (
          <span class="svh-insta__type">
            <Icon name="layers" />
          </span>
        )}
        {p.caption && <span class="svh-insta__cap">{short(p.caption)}</span>}
      </a>
    ))}
  </div>
) : (
  <div class="svh-insta-teaser">
    <div class="svh-insta__grid" aria-hidden="true">
      {tiles.map(([theme, seed]) => (
        <span class="svh-insta__item">
          <Pic
            theme={String(theme)}
            seed={Number(seed)}
            photo={false}
            width={480}
            widths={[240, 480]}
            sizes="(max-width: 480px) 50vw, 220px"
            w={600}
            h={600}
          />
        </span>
      ))}
    </div>
    <a class="svh-insta-teaser__card" href={instagram.url} target="_blank" rel="noopener noreferrer">
      <span class="svh-insta-cta__icon">
        <Icon name="instagram" />
      </span>
      <b>@{instagram.handle}</b>
      <span>Fotos, Spieltage und Vereinsleben</span>
      <span class="svh-btn svh-btn--primary svh-btn--sm">
        Auf Instagram folgen <Icon name="external" />
      </span>
    </a>
  </div>
)}
