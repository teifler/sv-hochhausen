---
interface Props {
  eyebrow?: string
  title: string
  lead?: string
  center?: boolean
  as?: 'h1' | 'h2'
  id?: string
  class?: string
}
const { eyebrow, title, lead, center = false, as: Tag = 'h2', id, class: cls } = Astro.props
---
<div class:list={['svh-section-head', center && 'svh-section-head--center', cls]}>
  {eyebrow && <span class="svh-eyebrow">{eyebrow}</span>}
  <Tag class="svh-section-title" id={id}>{title}</Tag>
  {lead && <p class="svh-section-lead">{lead}</p>}
  <slot />
</div>
