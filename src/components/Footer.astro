---
import Logo from './Logo.astro'
import Icon from './Icon.astro'
import { club, contact, footerNav, socials } from '../data/site.js'

const live = socials.filter((s) => s.url)
const year = new Date().getFullYear()
const c = contact.main
---
<footer class="svh-footer" id="svh-footer">
  <div class="svh-container svh-footer__top">
    <div class="svh-footer__brand-col">
      <a class="svh-footer__brand" href="/">
        <Logo size={46} title="" />
        <span><b>SV Hochhausen</b><span>Sportverein 1946 · Hochhausen/Tauber</span></span>
      </a>
      <p class="svh-footer__about">Der größte Verein in Hochhausen: Fußball, Bogenschießen, Darts, Damengymnastik, Nordic Walking und Wandern – seit 1946.</p>
      <div class="svh-social">
        {live.map((s) => (
          <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`${s.label} (öffnet neues Fenster)`}><Icon name={s.icon} /></a>
        ))}
      </div>
    </div>
    {
      footerNav.map((col) => (
        <div class="svh-footer__col">
          <h2>{col.title}</h2>
          {col.links.map((l) => (
            <a href={l.to}>{l.label}</a>
          ))}
        </div>
      ))
    }
    <div class="svh-footer__col">
      <h2>Kontakt</h2>
      <div class="svh-footer__contact">
        <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent('Zum Sportplatz 10, 97941 Tauberbischofsheim')}`} target="_blank" rel="noopener noreferrer">
          <Icon name="map-pin" />
          <span>{c.street}<br />{c.zip} {c.city}</span>
        </a>
        <a href={`tel:${c.phoneHref}`}><Icon name="phone" /><span>{c.phone} ({c.phoneLabel})</span></a>
        <a href={`mailto:${c.email}`}><Icon name="mail" /><span>{c.email}</span></a>
      </div>
    </div>
  </div>
  <div class="svh-footer__bottom">
    <div class="svh-container svh-footer__bottom-inner">
      <span>© {year} {club.legalName}</span>
      <nav class="svh-footer__legal" aria-label="Rechtliches">
        <a href="/impressum/">Impressum</a>
        <a href="/datenschutz/">Datenschutz</a>
        <a href="/kontakt/">Kontakt</a>
        <a href="/spenden/">Spenden</a>
      </nav>
    </div>
  </div>
</footer>
