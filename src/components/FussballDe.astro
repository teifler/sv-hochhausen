---
/* fussball.de: Teamkarte + Widgets (2-Klick-Lösung, DSGVO) */
import Icon from './Icon.astro'
import { fussballde } from '../data/fussballde.js'
import { fmtLong } from '../lib/format.js'

const team = fussballde.teams[0]
const s = fussballde.standing

function classic(w: any) {
  const id = `fbde-${w.id}`
  return (
    `<div id="${id}"></div>` +
    `<script src="https://www.fussball.de/static/layout/fbde2/egm//js/widget2.js"></script>` +
    `<script>new fussballdeWidgetAPI().showWidget('${id}', '${w.widgetId}');</script>`
  )
}
const widgets = fussballde.widgets
  .map((w) => ({ ...w, html: w.embedHtml || (w.widgetId ? classic(w) : null) }))
  .filter((w) => w.html)
---
<div class="svh-fbde">
  <span class="svh-fbde__badge"><Icon name="ball" /></span>
  <div>
    <div class="svh-fbde__team">{team.nameLong}</div>
    <div class="svh-fbde__meta">
      <span><Icon name="trophy" />{team.league}</span>
      <span><Icon name="handshake" />SpG mit dem {fussballde.partner.name}</span>
      <span><Icon name="calendar" />Saison {fussballde.season}</span>
    </div>
  </div>
  <div class="svh-fbde__cta">
    <a class="svh-btn svh-btn--dark svh-btn--sm" href={team.url} target="_blank" rel="noopener noreferrer">Team auf fussball.de <Icon name="external" /></a>
  </div>
</div>

{
  s && (
    <div class="svh-standing-wrap">
      <dl class="svh-standing" aria-label="Tabellenstand">
        <div><dt>Platz</dt><dd>{s.rank}.</dd></div>
        <div><dt>Punkte</dt><dd>{s.points}</dd></div>
        <div><dt>Spiele</dt><dd>{s.games}</dd></div>
        <div><dt>S / U / N</dt><dd>{s.won} / {s.drawn} / {s.lost}</dd></div>
        <div><dt>Tore</dt><dd>{s.goals}</dd></div>
      </dl>
      <p class="svh-standing__note">Stand {fmtLong(s.asOf)} laut fussball.de – tagesaktuell im Spielplan.</p>
    </div>
  )
}

{
  widgets.length ? (
    <div data-embed="fussballde">
      <div class="svh-consent" data-embed-consent>
        <p>
          <strong>Spielplan &amp; Tabelle live von fussball.de.</strong> Beim Laden werden Daten (u. a. deine IP-Adresse) an fussball.de
          übertragen. <a href="/datenschutz/#fussballde">Mehr dazu</a>
        </p>
        <div class="svh-actions">
          <label class="svh-check"><input type="checkbox" data-embed-remember />Für künftige Besuche merken</label>
          <button class="svh-btn svh-btn--primary svh-btn--sm" type="button" data-embed-load>Inhalte laden</button>
        </div>
      </div>
      <div class="svh-fbde__widgets">
        {widgets.map((w) => (
          <section class="svh-fbde__widget">
            <h3>{w.title}</h3>
            <div data-embed-slot>
              <template set:html={w.html}></template>
              <p class="svh-fbde__ph">Wird nach deiner Zustimmung geladen.</p>
            </div>
          </section>
        ))}
      </div>
    </div>
  ) : (
    <div class="svh-fbde__widgets svh-fbde__links">
      <a class="svh-info-card" href={team.url} target="_blank" rel="noopener noreferrer">
        <span class="svh-info-card__icon"><Icon name="calendar" /></span>
        <h3>Spielplan &amp; Ergebnisse</h3>
        <p>Alle Ansetzungen und Ergebnisse der SpG – tagesaktuell bei fussball.de.</p>
        <span class="svh-textlink">Öffnen <Icon name="external" /></span>
      </a>
      <a class="svh-info-card" href={team.url} target="_blank" rel="noopener noreferrer">
        <span class="svh-info-card__icon"><Icon name="trophy" /></span>
        <h3>Tabelle</h3>
        <p>Kreisklasse B Tauberbischofsheim, Staffel 2 – die aktuelle Tabelle auf der Teamseite.</p>
        <span class="svh-textlink">Öffnen <Icon name="external" /></span>
      </a>
      <a class="svh-info-card" href={fussballde.clubUrl} target="_blank" rel="noopener noreferrer">
        <span class="svh-info-card__icon"><Icon name="shield" /></span>
        <h3>Vereinsseite</h3>
        <p>Der SV Hochhausen auf fussball.de – Mannschaften und Spielstätte.</p>
        <span class="svh-textlink">Öffnen <Icon name="external" /></span>
      </a>
    </div>
  )
}
<script>
  import '../scripts/embeds.js'
</script>
