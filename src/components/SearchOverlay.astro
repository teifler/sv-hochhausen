---
import Icon from './Icon.astro'
---

<div
  class="svh-search"
  id="svh-search"
  data-search
  data-search-url="/suche.json"
  role="dialog"
  aria-modal="true"
  aria-label="Website durchsuchen"
  inert
>
  <div class="svh-search__box">
    <form class="svh-search__field" action="/suche/" method="get" role="search">
      <Icon name="search" />
      <input
        type="search"
        name="q"
        placeholder="Suchen: Training, Darts, Vorstand …"
        aria-label="Suchbegriff"
        autocomplete="off"
        data-search-input
      />
      <span class="svh-search__kbd" aria-hidden="true">
        Esc
      </span>
      <button class="svh-iconbtn" type="button" data-search-close aria-label="Suche schließen">
        <Icon name="x" />
      </button>
    </form>
    <div class="svh-search__results" data-search-results aria-live="polite">
      <p class="svh-search__empty">Tippe einen Suchbegriff ein – z. B. „Darts“, „Maiwanderung“ oder „Satzung“.</p>
    </div>
  </div>
  <p class="svh-search__hint">↑ ↓ zum Auswählen · Enter öffnet · Esc schließt</p>
</div>
