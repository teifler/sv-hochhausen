---
import Icon from '../Icon.astro'
import { instagram } from '../../data/site.js'
---

<a class="svh-insta-card" href={instagram.url} target="_blank" rel="noopener noreferrer">
  <span class="svh-insta-card__icon">
    <Icon name="instagram" />
  </span>
  <span class="svh-eyebrow">Aktuell auf Instagram</span>
  <h3 class="svh-insta-card__title">Mehr News, Fotos &amp; Storys</h3>
  <p class="svh-insta-card__text">
    Spieltage, Turniere, Wanderungen und Vereinsleben – das Neueste zeigen wir zuerst auf Instagram.
  </p>
  <span class="svh-insta-card__cta">
    @{instagram.handle} folgen <Icon name="external" />
  </span>
</a>
