---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Icon from '../../components/Icon.astro'
---
<BaseLayout title="Danke für deine Spende" noindex>
  <section class="svh-section svh-404">
    <div class="svh-container svh-container--narrow">
      <div class="svh-404__big" aria-hidden="true"><Icon name="heart" size={96} /></div>
      <h1 class="svh-section-title svh-mt-2">Vielen Dank!</h1>
      <p class="svh-section-lead svh-mt-2" style="margin-inline:auto">Deine Spendenzusage ist angekommen. Der Verein meldet sich in Kürze mit allen Details bei dir.</p>
      <div class="svh-actions svh-actions--center svh-mt-3">
        <a class="svh-btn svh-btn--primary" href="/">Zur Startseite</a>
        <a class="svh-btn svh-btn--outline" href="/sport/">Sportangebote</a>
      </div>
    </div>
  </section>
</BaseLayout>
