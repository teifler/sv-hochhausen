---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/PageHero.astro'
import Icon from '../components/Icon.astro'
import { nav } from '../data/site.js'
---
<BaseLayout title="Suche" description="Die Website des SV Hochhausen 1946 durchsuchen." noindex>
  <PageHero title="Suche" eyebrow="Website durchsuchen" theme="neutral" seed={9} />
  <section class="svh-section">
    <div class="svh-container svh-container--narrow">
      <form class="svh-searchpage__field" action="/suche/" method="get" role="search" data-searchpage>
        <Icon name="search" />
        <input type="search" name="q" placeholder="Suchbegriff eingeben …" aria-label="Suchbegriff" autocomplete="off" />
        <button class="svh-btn svh-btn--primary svh-btn--sm" type="submit">Suchen</button>
      </form>
      <p class="svh-form__note svh-mt-1" data-search-count aria-live="polite"></p>
      <div class="svh-result-list" data-search-list></div>
      <noscript>
        <p class="svh-empty svh-mt-2">Die Suche benötigt JavaScript. Hier findest du alle Bereiche der Website:</p>
        <ul class="svh-list-check svh-mt-2">{nav.map((n) => <li><a href={n.to}>{n.label}</a></li>)}</ul>
      </noscript>
    </div>
  </section>
  <script>
    import { escapeHtml, hrefFor, loadIndex, searchIndex } from '../scripts/searchcore.js'

    const form = document.querySelector('[data-searchpage]')
    const input = form?.querySelector('input')
    const listEl = document.querySelector('[data-search-list]')
    const countEl = document.querySelector('[data-search-count]')

    async function run(q) {
      const index = await loadIndex(document.querySelector('[data-search]')?.dataset.searchUrl || '/suche.json')
      const hits = searchIndex(index, q, 40)
      if (!q || q.trim().length < 2) {
        countEl.textContent = 'Bitte mindestens zwei Zeichen eingeben.'
        listEl.innerHTML = ''
        return
      }
      countEl.textContent = hits.length ? `${hits.length} Treffer für „${q}“` : `Keine Treffer für „${q}“.`
      listEl.innerHTML = hits
        .map(
          (h) =>
            `<a class="svh-result" href="${escapeHtml(hrefFor(h.url))}"><span class="svh-result__top"><span class="svh-badge svh-badge--muted">${escapeHtml(h.type)}</span><span class="svh-result__title">${escapeHtml(h.title)}</span></span>` +
            (h.meta ? `<span class="svh-result__text">${escapeHtml(h.meta)}</span>` : '') +
            `</a>`,
        )
        .join('')
    }

    const q = new URLSearchParams(location.search).get('q') || ''
    if (input) {
      input.value = q
      if (q) run(q)
      input.addEventListener('input', () => run(input.value))
      form.addEventListener('submit', (e) => {
        e.preventDefault()
        const url = new URL(location.href)
        url.searchParams.set('q', input.value)
        history.replaceState(null, '', url)
        run(input.value)
      })
    }
  </script>
</BaseLayout>
