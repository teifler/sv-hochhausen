---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PageHero from '../../components/PageHero.astro'
import Media from '../../components/Media.astro'
import Icon from '../../components/Icon.astro'
import NewsCard from '../../components/cards/NewsCard.astro'
import { news, newsSorted, newsCategories } from '../../data/news.js'
import { fmtLong } from '../../lib/format.js'

export function getStaticPaths() {
  return news.map((item) => ({ params: { slug: item.slug }, props: { item } }))
}

const { item } = Astro.props
const accent = newsCategories[item.category] || 'var(--svh-red)'
const more = newsSorted.filter((n) => n.slug !== item.slug).slice(0, 3)
const url = new URL(Astro.url.pathname, Astro.site ?? 'https://sv-hochhausen.vercel.app').href
---

<BaseLayout title={item.title} description={item.excerpt}>
  <PageHero
    title={item.title}
    eyebrow={item.category}
    theme={item.theme}
    seed={item.seed}
    crumbs={[{ label: 'Aktuelles', to: '/aktuelles/' }]}
  />

  <article class="svh-section">
    <div class="svh-container svh-container--narrow">
      <div class="svh-article__meta">
        <span class="svh-badge svh-badge--solid" style={`background:${accent}`}>
          {item.category}
        </span>
        <time datetime={item.date}>
          <Icon name="calendar" />
          {fmtLong(item.date)}
        </time>
      </div>
      <div class="svh-prose">
        <p class="svh-article__lead">{item.excerpt}</p>
        <Media theme={item.theme} seed={item.seed} ratio="16x9" width={1000} sizes="(max-width: 820px) 100vw, 780px" />
        {item.body.map((p: string) => (
          <p>{p}</p>
        ))}
      </div>
      {item.tags?.length > 0 && (
        <div class="svh-tags svh-mt-3">
          {item.tags.map((t: string) => (
            <span class="svh-chip">#{t}</span>
          ))}
        </div>
      )}
      <div class="svh-actions svh-mt-3">
        <a class="svh-btn svh-btn--outline svh-btn--sm" href="/aktuelles/">
          <Icon name="arrow-left" />
          Alle Nachrichten
        </a>
        <button class="svh-btn svh-btn--light svh-btn--sm" type="button" data-copy={url}>
          <Icon name="copy" />
          <span data-copy-label>Link kopieren</span>
        </button>
      </div>
    </div>
  </article>

  <section class="svh-section svh-section--soft">
    <div class="svh-container">
      <div class="svh-section-head">
        <span class="svh-eyebrow">Weiterlesen</span>
        <h2 class="svh-section-title">Weitere Nachrichten</h2>
      </div>
      <div class="svh-grid svh-grid--3">
        {more.map((n) => (
          <NewsCard item={n} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
