# =============================================================
#  Umgebungsvariablen – Vorlage
#  Lokal: als .env kopieren und ausfüllen (.env ist in .gitignore).
#  Für den automatischen Upload: `bash scripts/deploy-secrets.sh` überträgt
#  die DEPLOY_*-Werte als Secrets nach GitHub (Environment „production“).
#
#  ⚠️ Das Repository ist ÖFFENTLICH. In diese Datei gehören nur die Namen der
#  Variablen – keine Server, Loginnamen, Ports, Pfade, Passwörter oder Schlüssel.
#  Die echten Werte stehen in der Hosting-Verwaltung.
#  Details: ANPASSEN.md, Abschnitte 5, 7 und 8.
# =============================================================

# Öffentliche Adresse (Canonical-Links, Open Graph, Sitemap)
SITE_URL=https://sportverein-hochhausen.de

# --- Upload auf den Webspace (SFTP mit Deploy-Schlüssel) ---------
# Werte nur lokal bzw. als GitHub-Secrets mit gleichem Namen
DEPLOY_HOST=
DEPLOY_PORT=
DEPLOY_USER=
DEPLOY_PATH=

# Kontakt- und Spendenformular brauchen keine Zugangsdaten: Sie laufen als PHP auf dem
# Webspace und verschicken über dessen Mailfunktion. Empfänger: src/data/forms.js

# --- Instagram (beim Build geladen, lokal ausgeliefert) --------
# Variante A: Behold-JSON-Feed (https://feeds.behold.so/…)
INSTAGRAM_FEED_URL=
# Variante B: Instagram-API-Token (Business-/Creator-Konto)
INSTAGRAM_TOKEN=
# Anzahl Beiträge (1–24, Standard 12)
INSTAGRAM_LIMIT=12

# --- Build-Schalter ---------------------------------------------
# off = keine Stockfotos laden (SVG-Grafiken stattdessen)
SVH_PHOTOS=
# 1 = Vorschau mit Stockfotos vom Pexels-CDN – NIE für die Live-Seite (Datenschutz)
SVH_HOTLINK=
