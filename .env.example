# =============================================================
#  Umgebungsvariablen – Vorlage
#  Lokal: als .env kopieren und ausfüllen (.env ist in .gitignore).
#  Vercel: Project → Settings → Environment Variables, danach Redeploy.
#  Details: ANPASSEN.md, Abschnitte 5, 7 und 8.
# =============================================================

# Öffentliche Adresse (Canonical-Links, Open Graph, Sitemap)
SITE_URL=https://sv-hochhausen.vercel.app

# --- Kontakt- & Spendenformular (SMTP, jedes Postfach) ---------
# Ohne SMTP_HOST/SMTP_USER/SMTP_PASS zeigen die Formulare die E-Mail-Adresse als Alternative.
SMTP_HOST=
SMTP_PORT=587
# nur bei Port 465: true
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Empfänger der Anfragen (Standard: info@sportverein-hochhausen.de)
MAIL_TO=
# optional: eigener Empfänger für Spendenzusagen
DONATION_TO=

# --- Instagram (beim Build geladen, lokal ausgeliefert) --------
# Variante A: Behold-JSON-Feed (https://feeds.behold.so/…)
INSTAGRAM_FEED_URL=
# Variante B: Instagram-API-Token (Business-/Creator-Konto)
INSTAGRAM_TOKEN=
# Anzahl Beiträge (1–24, Standard 12)
INSTAGRAM_LIMIT=12

# --- Build-Schalter ---------------------------------------------
# off = keine Stockfotos laden (SVG-Grafiken stattdessen)
SVH_PHOTOS=
# 1 = Vorschau mit Stockfotos vom Pexels-CDN – NIE für die Live-Seite (Datenschutz)
SVH_HOTLINK=
