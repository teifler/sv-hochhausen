# =============================================================
#  Umgebungsvariablen – Vorlage
#  Lokal: als .env kopieren und ausfüllen (.env ist in .gitignore).
#  Für den automatischen Upload: Werte als GitHub-Secrets hinterlegen
#  (Repository → Settings → Secrets and variables → Actions).
#
#  ⚠️ Das Repository ist ÖFFENTLICH. In diese Datei gehören nur die Namen der
#  Variablen – keine Server, Loginnamen, Ports, Pfade, Passwörter oder Schlüssel.
#  Die echten Werte stehen in der Hosting-Verwaltung bzw. im Postfach.
#  Details: ANPASSEN.md, Abschnitte 5, 7 und 8.
# =============================================================

# Öffentliche Adresse (Canonical-Links, Open Graph, Sitemap)
SITE_URL=https://sportverein-hochhausen.de

# --- Upload auf den Webspace (SFTP) -----------------------------
# Werte nur lokal bzw. als GitHub-Secrets mit gleichem Namen
DEPLOY_HOST=
DEPLOY_PORT=
DEPLOY_USER=
DEPLOY_PATH=

# --- Kontakt- & Spendenformular (SMTP) --------------------------
# Werte aus den Postfach-Einstellungen; Login ist meist die volle Postfach-Adresse.
# Ohne SMTP_HOST/SMTP_USER/SMTP_PASS zeigen die Formulare die E-Mail-Adresse als Alternative.
SMTP_HOST=
SMTP_PORT=587
# nur bei Port 465: true
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Empfänger der Anfragen (Standard: info@sportverein-hochhausen.de)
MAIL_TO=
# optional: eigener Empfänger für Spendenzusagen
DONATION_TO=

# --- Instagram (beim Build geladen, lokal ausgeliefert) --------
# Variante A: Behold-JSON-Feed (https://feeds.behold.so/…)
INSTAGRAM_FEED_URL=
# Variante B: Instagram-API-Token (Business-/Creator-Konto)
INSTAGRAM_TOKEN=
# Anzahl Beiträge (1–24, Standard 12)
INSTAGRAM_LIMIT=12

# --- Build-Schalter ---------------------------------------------
# off = keine Stockfotos laden (SVG-Grafiken stattdessen)
SVH_PHOTOS=
# 1 = Vorschau mit Stockfotos vom Pexels-CDN – NIE für die Live-Seite (Datenschutz)
SVH_HOTLINK=
